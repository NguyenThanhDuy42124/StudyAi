# ==========================================
# StudyAI - Environment Configuration Template
# ==========================================

# ── Core Environment & Security
FASTAPI_ENV=development
PROJECT_NAME="AI Student Assistant"
SECRET_KEY=generate_a_random_secret_key_here_or_use_default
FIRST_SUPERUSER=admin@admin.com
FIRST_SUPERUSER_PASSWORD=admin123

# ── Database (PostgreSQL)
POSTGRES_PASSWORD=12345
DATABASE_URL=postgresql://postgres:@localhost:5432/app

# ── AI Providers (Dien it nhat 1 API key de kich hoat AI)
# 1. Google Gemini (Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# 2. NVIDIA Build (Free 1000 Credits)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# 3. Groq Cloud (Free Tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Vector Database & Encryption
ENCRYPTION_KEY=
QDRANT_URL=local_qdrant_db

# ── Emails (Optional for testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
EMAILS_FROM_EMAIL=info@example.com
